{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "lokii-search",
  "title": "Lokii Search",
  "description": "Search the local file index maintained by Lokii.",
  "author": "evan",
  "icon": "icon.png",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity",
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-files",
      "title": "Search Files with Lokii",
      "description": "Find and open files and folders using Lokii.",
      "mode": "view"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist -o dist --exit-on-error",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "^2.11.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
